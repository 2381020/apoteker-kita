@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 240 240 248;
    --foreground: 15 23 42;
    --card: 255 255 255;
    --card-foreground: 15 23 42;
    --popover: 255 255 255;
    --popover-foreground: 15 23 42;
    --primary: 210 85 22;
    --primary-foreground: 245 245 245;
    --primary-soft: 253 247 230;
    --secondary: 13 148 136;
    --secondary-foreground: 255 255 255;
    --muted: 249 250 252;
    --muted-foreground: 107 114 128;
    --accent: 248 250 252;
    --accent-foreground: 15 23 42;
    --success: 22 163 74;
    --warning: 217 119 6;
    --destructive: 185 28 28;
    --destructive-foreground: 255 255 255;
    --border: 229 231 235;
    --input: 249 250 252;
    --ring: 210 85 22;
    --radius: 0.5rem;
  }

  * {
    border-color: rgb(var(--border));
  }

  html {
    font-family: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body {
    background-color: rgb(var(--background));
    color: rgb(var(--foreground));
    font-feature-settings: "rlig" 1, "calt" 1;
    line-height: 1.6;
    min-height: 100vh;
  }

  *::selection {
    background-color: rgb(var(--primary) / 0.25);
  }

  h1,
  h2,
  h3,
  h4 {
    letter-spacing: -0.02em;
    color: rgb(var(--foreground));
    font-weight: 600;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  button {
    font-family: inherit;
    cursor: pointer;
  }

  img {
    max-width: 100%;
    height: auto;
  }
}

@layer components {
  .btn-primary {
    @apply bg-primary text-primary-foreground hover:bg-primary/90;
  }

  .btn-secondary {
    @apply bg-secondary text-secondary-foreground hover:bg-secondary/80;
  }

  .btn-outline {
    @apply border border-border bg-transparent text-main-text hover:bg-accent/5;
  }

  .btn-ghost {
    @apply hover:bg-accent hover:text-accent-foreground;
  }

  .input-field {
    @apply flex h-10 w-full rounded-md border border-input bg-surface px-3 py-2 text-sm text-main-text placeholder:text-secondary-text/60 shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:border-primary disabled:cursor-not-allowed disabled:opacity-50;
  }

  .card {
    @apply rounded-lg bg-surface text-card-foreground shadow-sm;
  }

  .card-header {
    @apply flex flex-col space-y-1.5 p-6 sm:p-8;
  }

  .card-title {
    @apply text-lg font-medium leading-none tracking-tight text-main-text;
  }

  .card-description {
    @apply text-sm text-secondary-text;
  }

  .card-content {
    @apply p-6 sm:p-8 pt-0;
  }

  .card-footer {
    @apply flex items-center p-6 sm:p-8 pt-0;
  }

  .dialog-overlay {
    @apply fixed inset-0 bg-black/40 backdrop-blur-sm;
  }

  .dialog-content {
    @apply relative flex max-h-[calc(100dvh-2rem)] w-full max-w-lg flex-col overflow-hidden rounded-lg border border-bg surface bg-surface shadow-sm;
  }
}

  * {
    border-color: rgb(var(--border));
  }

  html {
    font-family: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background-color: rgb(var(--background));
    color: rgb(var(--foreground));
    font-feature-settings: "rlig" 1, "calt" 1;
    min-height: 100vh;
  }

  ::selection {
    background-color: rgb(var(--primary) / 0.25);
  }
}

@layer base {
  h1,
  h2,
  h3,
  h4 {
    letter-spacing: -0.02em;
    color: rgb(var(--foreground));
  }
}

@layer components {
  .bg-background {
    background-color: rgb(var(--background));
  }
  .text-main-text {
    color: #0f172a;
  }
  .text-secondary-text {
    color: #64748b;
  }
  .border-border {
    border-color: #e2e8f0;
  }
  .bg-surface {
    background-color: #ffffff;
  }
  .bg-primary-soft {
    background-color: rgb(var(--primary-soft));
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}


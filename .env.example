# Salin file ini menjadi .env.local lalu isi nilai dari dashboard Supabase.
# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=
# Project Settings -> API -> Project API keys -> anon/public
VITE_SUPABASE_ANON_KEY=

# Hanya untuk script seed lokal (npm run seed:users).
# JANGAN memakai prefix VITE_ agar tidak ikut ter-bundle ke browser.
SUPABASE_SERVICE_ROLE_KEY=
